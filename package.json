{
  "name": "okapi",
  "displayName": "okapi",
  "version": "1.7.13",
  "description": "Ultra-lightweight Rest API debugging tool for VS Code.",
  "categories": [
    "Programming Languages",
    "Snippets",
    "Testing"
  ],
  "keywords": [
    "api client",
    "api debbug",
    "api testing",
    "apiclient",
    "bruno",
    "http client",
    "insomnia",
    "postman",
    "rest api",
    "rest client",
    "restclient",
    "server sent events",
    "socket.io",
    "socket.io client",
    "sse",
    "testing",
    "thunder client",
    "thunderclient",
    "websocket client"
  ],
  "homepage": "https://github.com/hazicy/echoapi-for-vscode",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hazicy/echoapi-for-vscode.git"
  },
  "publisher": "hazicy",
  "files": [
    "LICENSE.txt",
    "dist/**",
    "package.nls*.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "yarn run package",
    "compile": "yarn build:webviews --mode development && yarn build:extension",
    "watch": "concurrently --kill-others \"tsup --watch\" \"vite build --watch --mode development\"",
    "package": "vite build && tsup --minify && node scripts/check-extension.cjs && node scripts/check-webviews.cjs && yarn check:ui",
    "package:test": "yarn compile",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "yarn run compile-tests && yarn run compile && yarn run lint",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vscode-test",
    "test:editor": "playwright test --config tests/editor/playwright.config.ts",
    "build": "vsce package",
    "start": "concurrently --kill-others \"tsup --watch --env.ECHOAPI_DEV_SERVER true\" \"vite --host 127.0.0.1\"",
    "debug": "code --extensionDevelopmentPath=.",
    "build:extension": "tsup",
    "build:webviews": "vite build",
    "test:ui": "playwright test --config tests/ui/playwright.config.ts",
    "check:ui": "node scripts/check-ui-migration.cjs"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^9.0.9",
    "@base-ui/react": "^1.9.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@iconify-icons/lucide": "^2.0.23",
    "@iconify/react": "^6.0.3",
    "@prettier/plugin-xml": "^3.4.2",
    "ahooks": "^3.7.8",
    "ajv": "^8.11.0",
    "ajv-i18n": "^4.2.0",
    "apipost-inside-tools": "^0.1.94",
    "apipost-mock-schema": "^0.0.53",
    "apipost-tools": "^0.0.41",
    "auto-json-faker": "^1.0.8",
    "axios": "^1.7.7",
    "classnames": "^2.5.1",
    "cm6-graphql": "^0.2.2",
    "csvtojson": "^2.0.10",
    "curl-to-postmanv2": "^1.8.1",
    "dayjs": "^1.11.10",
    "echoapi-converter": "0.0.89",
    "exp-mock": "^2.0.15",
    "express": "^4.21.1",
    "fast-xml-parser": "^4.0.12",
    "file-saver": "^2.0.5",
    "graphql": "^16.9.0",
    "har2languages": "^0.0.5",
    "i18next": "^23.7.11",
    "iconv-lite": "^0.6.3",
    "immer": "^9.0.15",
    "json5": "^2.2.3",
    "jsonc-parser": "^3.3.1",
    "jsondiffpatch": "^0.4.1",
    "jsonpath": "^1.1.1",
    "jsonschema": "^1.4.1",
    "lodash": "^4.17.21",
    "mathjs": "^13.1.1",
    "mermaid": "^10.6.1",
    "mockjs": "^1.1.0",
    "mockjs5-pro": "^1.0.3",
    "prettier": "^3.9.10",
    "qs": "^6.11.2",
    "rc-field-form": "^2.7.1",
    "rc-table": "^7.55.1",
    "rc-tree": "^5.13.1",
    "rc-tree-select": "^5.27.0",
    "rc-upload": "^4.11.0",
    "rc-virtual-list": "^3.12.0",
    "react": "19",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "19",
    "react-hotkeys-hook": "^4.5.0",
    "react-i18next": "^14.0.0",
    "react-json-view": "^1.21.3",
    "react-pdf": "^11.0.0",
    "react-resizable": "^3.0.5",
    "react-resizable-panels": "^1.0.9",
    "react-router-dom": "6.21.0",
    "socket.io-client-pro": "^1.0.20",
    "sql-ddl-to-json-schema": "^4.1.0",
    "url-parse": "^1.5.10",
    "web-curl-to-har": "^1.0.3",
    "websocket-client-pro": "^1.0.26",
    "x2js": "^3.4.4",
    "xmldom": "^0.6.0",
    "xpath": "^0.0.33",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/file-saver": "^2.0.7",
    "@types/jsonpath": "^0.2.4",
    "@types/lodash": "^4.14.202",
    "@types/mocha": "^10.0.7",
    "@types/mockjs": "^1.0.10",
    "@types/node": "20.x",
    "@types/qs": "^6.9.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-resizable": "^3.0.7",
    "@types/url-parse": "^1.4.11",
    "@types/vscode": "^1.74.3",
    "@types/xmldom": "^0.1.34",
    "@vitejs/plugin-react": "^5",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.4.0",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tsup": "^9.0.0",
    "type-fest": "^4.8.3",
    "typescript": "^5.4.5",
    "vite": "^7",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-plugin-svgr": "^5.2.0"
  },
  "resolutions": {
    "uvm": "3.0.0"
  },
  "contributes": {
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "echoapi.documentServicePort": {
          "type": "number",
          "default": 3000,
          "description": "%configuration.documentServicePort.description%"
        },
        "echoapi.nativeTree": {
          "type": "boolean",
          "default": true,
          "description": "Use the native VS Code tree for requests, automation tests and request history. Disable to restore the Webview sidebar."
        }
      }
    },
    "submenus": [
      {
        "id": "myView.commit",
        "label": "%submenu.commit%"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "myExtension",
          "title": "okapi",
          "icon": "dist/images/okapi-activity.svg"
        }
      ]
    },
    "views": {
      "myExtension": [
        {
          "id": "myView",
          "name": "okapi",
          "type": "webview",
          "icon": "dist/images/okapi-activity.svg",
          "when": "!config.echoapi.nativeTree"
        },
        {
          "id": "okapiRequests",
          "name": "%view.requests%",
          "when": "config.echoapi.nativeTree"
        },
        {
          "id": "okapiTests",
          "name": "%view.tests%",
          "when": "config.echoapi.nativeTree",
          "collapsed": true
        },
        {
          "id": "okapiHistory",
          "name": "%view.history%",
          "when": "config.echoapi.nativeTree",
          "collapsed": true
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "echoapi.switchWorkspace",
          "when": "view == myView || view == okapiRequests",
          "group": "1_workspace@1"
        },
        {
          "command": "openImportDataPanel",
          "when": "view == myView || view == okapiRequests",
          "group": "1_workspace@2"
        },
        {
          "command": "openExportDataPanel",
          "when": "view == myView || view == okapiRequests",
          "group": "1_workspace@3"
        },
        {
          "command": "echoapi.openEnv",
          "when": "view == myView || view == okapiRequests",
          "group": "@2",
          "order": 1
        },
        {
          "command": "echoapi.openExtenisonSettings",
          "when": "view == myView || view == okapiRequests",
          "group": "@2",
          "order": 2
        },
        {
          "command": "echoapi.openHelpDoc",
          "when": "view == myView || view == okapiRequests",
          "group": "@3",
          "order": 100
        },
        {
          "command": "echoapi.feedBack",
          "when": "view == myView || view == okapiRequests",
          "group": "@3",
          "order": 200
        },
        {
          "command": "okapi.tree.new",
          "when": "view == okapiRequests",
          "group": "navigation@4"
        },
        {
          "command": "okapi.tree.filter",
          "when": "view == okapiRequests",
          "group": "navigation@5"
        },
        {
          "command": "okapi.tree.refresh",
          "when": "view == okapiRequests",
          "group": "2_view@1"
        },
        {
          "command": "okapi.tree.runTests",
          "when": "view == okapiTests",
          "group": "navigation@1"
        },
        {
          "command": "okapi.tree.refresh",
          "when": "view == okapiTests || view == okapiHistory",
          "group": "navigation@3"
        },
        {
          "command": "okapi.tree.filter",
          "when": "view == okapiHistory",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "okapi.tree.new",
          "when": "view == okapiRequests && viewItem == okapiFolder",
          "group": "inline"
        },
        {
          "command": "okapi.tree.runTests",
          "when": "view == okapiTests && viewItem == okapiTestFolder",
          "group": "inline"
        },
        {
          "command": "okapi.tree.deleteReport",
          "when": "view == okapiTests && viewItem == okapiReport",
          "group": "management"
        },
        {
          "command": "okapi.tree.rename",
          "when": "view == okapiRequests && viewItem =~ /^(okapiFolder|okapiRequest|okapiRequestHttp)$/",
          "group": "3_edit@1"
        },
        {
          "command": "okapi.tree.clone",
          "when": "view == okapiRequests && viewItem =~ /^okapiRequest/",
          "group": "3_edit@2"
        },
        {
          "command": "okapi.tree.delete",
          "when": "view == okapiRequests && viewItem =~ /^(okapiFolder|okapiRequest|okapiRequestHttp)$/",
          "group": "4_delete"
        },
        {
          "command": "okapi.tree.copyCurl",
          "when": "view == okapiRequests && viewItem == okapiRequestHttp",
          "group": "2_copy"
        },
        {
          "command": "okapi.tree.revealStorage",
          "when": "view == okapiRequests && viewItem =~ /^(okapiFolder|okapiRequest|okapiRequestHttp)$/",
          "group": "2_reveal"
        },
        {
          "command": "okapi.tree.folderSettings",
          "when": "view == okapiRequests && viewItem == okapiFolder",
          "group": "3_edit@0"
        },
        {
          "command": "okapi.tree.folderReports",
          "when": "view == okapiRequests && viewItem == okapiFolder",
          "group": "1_test@2"
        },
        {
          "command": "okapi.tree.new.api",
          "when": "view == okapiRequests && viewItem == okapiFolder",
          "group": "0_new@0"
        },
        {
          "command": "okapi.tree.new.sse",
          "when": "view == okapiRequests && viewItem == okapiFolder",
          "group": "0_new@1"
        },
        {
          "command": "okapi.tree.new.graphql",
          "when": "view == okapiRequests && viewItem == okapiFolder",
          "group": "0_new@2"
        },
        {
          "command": "okapi.tree.new.websocket2",
          "when": "view == okapiRequests && viewItem == okapiFolder",
          "group": "0_new@3"
        },
        {
          "command": "okapi.tree.new.socketio",
          "when": "view == okapiRequests && viewItem == okapiFolder",
          "group": "0_new@4"
        },
        {
          "command": "okapi.tree.new.folder",
          "when": "view == okapiRequests && viewItem == okapiFolder",
          "group": "0_new@5"
        },
        {
          "command": "okapi.tree.runTests",
          "when": "view == okapiRequests && viewItem == okapiFolder",
          "group": "1_test@1"
        }
      ]
    },
    "commands": [
      {
        "command": "echoapi.switchWorkspace",
        "title": "%command.switchWorkspace%",
        "icon": {
          "light": "dist/images/workspace-switch-light.svg",
          "dark": "dist/images/workspace-switch-dark.svg"
        }
      },
      {
        "command": "echoapi.openEnv",
        "title": "%command.openEnv%"
      },
      {
        "command": "echoapi.openExtenisonSettings",
        "title": "%command.openExtenisonSettings%"
      },
      {
        "command": "echoapi.feedBack",
        "title": "%command.feedBack%",
        "category": "okapi"
      },
      {
        "command": "echoapi.openHelpDoc",
        "title": "%command.openHelpDoc%",
        "category": "okapi"
      },
      {
        "command": "openImportDataPanel",
        "title": "%command.importData%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "openExportDataPanel",
        "title": "%command.exportData%",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "okapi.tree.new",
        "title": "%command.tree.new%",
        "icon": "$(add)"
      },
      {
        "command": "okapi.tree.filter",
        "title": "%command.tree.filter%",
        "icon": "$(filter)"
      },
      {
        "command": "okapi.tree.refresh",
        "title": "%command.tree.refresh%",
        "icon": "$(refresh)"
      },
      {
        "command": "okapi.tree.open",
        "title": "Open Request"
      },
      {
        "command": "okapi.tree.runTests",
        "title": "%command.tree.runTests%",
        "icon": "$(play)"
      },
      {
        "command": "okapi.tree.deleteReport",
        "title": "%command.tree.deleteReport%",
        "icon": "$(trash)"
      },
      {
        "command": "okapi.tree.rename",
        "title": "%command.tree.rename%",
        "icon": "$(edit)"
      },
      {
        "command": "okapi.tree.clone",
        "title": "%command.tree.clone%",
        "icon": "$(copy)"
      },
      {
        "command": "okapi.tree.delete",
        "title": "%command.tree.delete%",
        "icon": "$(trash)"
      },
      {
        "command": "okapi.tree.copyCurl",
        "title": "%command.tree.copyCurl%",
        "icon": "$(copy)"
      },
      {
        "command": "okapi.tree.revealStorage",
        "title": "%command.tree.revealStorage%",
        "icon": "$(folder-opened)"
      },
      {
        "command": "okapi.tree.folderSettings",
        "title": "%command.tree.folderSettings%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "okapi.tree.folderReports",
        "title": "%command.tree.folderReports%",
        "icon": "$(history)"
      },
      {
        "command": "okapi.tree.new.api",
        "title": "%command.tree.new.api%",
        "icon": "$(add)"
      },
      {
        "command": "okapi.tree.new.sse",
        "title": "%command.tree.new.sse%",
        "icon": "$(add)"
      },
      {
        "command": "okapi.tree.new.graphql",
        "title": "%command.tree.new.graphql%",
        "icon": "$(add)"
      },
      {
        "command": "okapi.tree.new.websocket2",
        "title": "%command.tree.new.websocket2%",
        "icon": "$(add)"
      },
      {
        "command": "okapi.tree.new.socketio",
        "title": "%command.tree.new.socketio%",
        "icon": "$(add)"
      },
      {
        "command": "okapi.tree.new.folder",
        "title": "%command.tree.new.folder%",
        "icon": "$(new-folder)"
      }
    ]
  },
  "activationEvents": [],
  "icon": "dist/images/okapi-icon.png",
  "engines": {
    "vscode": "^1.74.3"
  },
  "sandbox": false
}
