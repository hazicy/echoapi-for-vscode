{
  "name": "okapi",
  "displayName": "okapi",
  "description": "Ultra-lightweight Rest API debugging tool for VS Code.",
  "version": "1.7.13",
  "publisher": "hazicy",
  "homepage": "https://github.com/hazicy/echoapi-for-vscode",
  "repository": {
    "type": "git",
    "url": "https://github.com/hazicy/echoapi-for-vscode.git"
  },
  "scripts": {
    "vscode:prepublish": "yarn run package",
    "compile": "yarn build:webviews --mode development && yarn build:extension",
    "watch": "concurrently --kill-others \"tsup --watch\" \"vite build --watch --mode development\"",
    "package": "vite build && tsup --minify && node scripts/check-extension.cjs && node scripts/check-webviews.cjs && yarn check:ui",
    "package:test": "yarn compile",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "yarn run compile-tests && yarn run compile && yarn run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test",
    "test:editor": "playwright test --config tests/editor/playwright.config.ts",
    "build": "vsce package",
    "start": "concurrently --kill-others \"tsup --watch --env.ECHOAPI_DEV_SERVER true\" \"vite --host 127.0.0.1\"",
    "debug": "code --extensionDevelopmentPath=.",
    "build:extension": "tsup",
    "build:webviews": "vite build",
    "test:ui": "playwright test --config tests/ui/playwright.config.ts",
    "check:ui": "node scripts/check-ui-migration.cjs"
  },
  "engines": {
    "vscode": "^1.74.3"
  },
  "keywords": [
    "rest client",
    "http client",
    "api client",
    "postman",
    "testing",
    "thunderclient",
    "thunder client",
    "restclient",
    "apiclient",
    "insomnia",
    "bruno",
    "api debbug",
    "api testing",
    "rest api",
    "websocket client",
    "socket.io client",
    "socket.io",
    "sse",
    "server sent events"
  ],
  "categories": [
    "Programming Languages",
    "Snippets",
    "Testing"
  ],
  "icon": "dist/images/okapi-icon.png",
  "activationEvents": [],
  "main": "./dist/extension.js",
  "license": "MIT",
  "files": [
    "LICENSE.txt",
    "dist/**",
    "package.nls*.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "sandbox": false,
  "contributes": {
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "echoapi.documentServicePort": {
          "type": "number",
          "default": 3000,
          "description": "%configuration.documentServicePort.description%"
        }
      }
    },
    "submenus": [
      {
        "id": "myView.commit",
        "label": "%submenu.commit%"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "myExtension",
          "title": "okapi",
          "icon": "dist/images/okapi-activity.svg"
        }
      ]
    },
    "views": {
      "myExtension": [
        {
          "id": "myView",
          "name": "okapi",
          "type": "webview",
          "icon": "dist/images/okapi-activity.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "echoapi.openEnv",
          "when": "view == myView",
          "group": "@2",
          "order": 1
        },
        {
          "command": "echoapi.openExtenisonSettings",
          "when": "view == myView",
          "group": "@2",
          "order": 2
        },
        {
          "command": "echoapi.openHelpDoc",
          "when": "view == myView",
          "group": "@3",
          "order": 100
        },
        {
          "command": "echoapi.feedBack",
          "when": "view == myView",
          "group": "@3",
          "order": 200
        }
      ]
    },
    "commands": [
      {
        "command": "echoapi.openEnv",
        "title": "%command.openEnv%"
      },
      {
        "command": "echoapi.openExtenisonSettings",
        "title": "%command.openExtenisonSettings%"
      },
      {
        "command": "echoapi.feedBack",
        "title": "%command.feedBack%",
        "category": "okapi"
      },
      {
        "command": "echoapi.openHelpDoc",
        "title": "%command.openHelpDoc%",
        "category": "okapi"
      }
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/file-saver": "^2.0.7",
    "@types/jsonpath": "^0.2.4",
    "@types/lodash": "^4.14.202",
    "@types/mocha": "^10.0.7",
    "@types/mockjs": "^1.0.10",
    "@types/node": "20.x",
    "@types/qs": "^6.9.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-resizable": "^3.0.7",
    "@types/url-parse": "^1.4.11",
    "@types/vscode": "^1.74.3",
    "@types/xmldom": "^0.1.34",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.11.0",
    "@vitejs/plugin-react": "^5",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.4.0",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "tsup": "^9.0.0",
    "type-fest": "^4.8.3",
    "typescript": "^5.4.5",
    "vite": "^7",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-plugin-svgr": "^5.2.0"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^9.0.9",
    "@base-ui/react": "^1.9.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@iconify-icons/lucide": "^2.0.23",
    "@iconify/react": "^6.0.3",
    "@prettier/plugin-xml": "^3.4.2",
    "ahooks": "^3.7.8",
    "ajv": "^8.11.0",
    "ajv-i18n": "^4.2.0",
    "apipost-inside-tools": "^0.1.94",
    "apipost-mock-schema": "^0.0.53",
    "apipost-tools": "^0.0.41",
    "auto-json-faker": "^1.0.8",
    "axios": "^1.7.7",
    "classnames": "^2.5.1",
    "cm6-graphql": "^0.2.2",
    "csvtojson": "^2.0.10",
    "curl-to-postmanv2": "^1.8.1",
    "dayjs": "^1.11.10",
    "echoapi-converter": "0.0.89",
    "exp-mock": "^2.0.15",
    "express": "^4.21.1",
    "fast-xml-parser": "^4.0.12",
    "file-saver": "^2.0.5",
    "graphql": "^16.9.0",
    "har2languages": "^0.0.5",
    "i18next": "^23.7.11",
    "iconv-lite": "^0.6.3",
    "immer": "^9.0.15",
    "json5": "^2.2.3",
    "jsonc-parser": "^3.3.1",
    "jsondiffpatch": "^0.4.1",
    "jsonpath": "^1.1.1",
    "jsonschema": "^1.4.1",
    "lodash": "^4.17.21",
    "mathjs": "^13.1.1",
    "mermaid": "^10.6.1",
    "mockjs": "^1.1.0",
    "mockjs5-pro": "^1.0.3",
    "prettier": "^3.9.10",
    "qs": "^6.11.2",
    "rc-field-form": "^2.7.1",
    "rc-table": "^7.55.1",
    "rc-tree": "^5.13.1",
